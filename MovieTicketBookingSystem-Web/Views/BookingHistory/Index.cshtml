@model List<string>

@{
    ViewData["Title"] = "Booking History";
}

<div class="container mt-5">

    <div class="text-center mb-4">

        <h1 class="display-5 fw-bold">
            Booking History
        </h1>

        <p class="text-muted">
            View your previous movie ticket bookings.
        </p>

    </div>


    @if (Model.Count == 0)
    {
        <div class="alert alert-info text-center">

            No bookings found.

        </div>
    }
    else
    {
        @foreach (var booking in Model)
        {
            <div class="card booking-history-card">

                <div class="card-body">

                    <pre class="mb-0"
                         style="font-family: inherit; white-space: pre-wrap;">@booking</pre>

                </div>

            </div>
        }
    }


    <div class="text-center mt-4">

        <a asp-controller="Booking"
           asp-action="Index"
           class="btn btn-success">

            Book Another Ticket

        </a>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-primary ms-2">

            Back to Home

        </a>

    </div>

</div>