@{
    ViewData["Title"] = "Booking Successful";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow-sm text-center">

                <div class="card-body p-5">

                    <h1 class="text-success mb-3">
                        Booking Successful!
                    </h1>

                    <p class="lead">
                        Your movie ticket has been booked successfully.
                    </p>

                    <p class="text-muted">
                        Thank you for using the Movie Ticket Booking System.
                    </p>

                    <div class="mt-4">

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-primary me-2">
                            Back to Home
                        </a>

                        <a asp-controller="Booking"
                           asp-action="Index"
                           class="btn btn-success">
                            Book Another Ticket
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>